  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>sample_state</name>
    <x>865</x>
    <y>295</y>
    <width>400</width>
    <height>28</height>
    <text>UNKNOWN / NO DATA</text>
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>PUMPED (&lt;0.01 mbar, raw)</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>VENTED RANGE (&gt;=600 mbar)</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 2">
          <value>BETWEEN TARGETS</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 3">
          <value>UNDER RANGE (reported zero)</value>
        </exp>
        <pv trig="true">$(P)View:Sample-Sts</pv>
      </rule>
    </rules>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>intermediate_state</name>
    <x>370</x>
    <y>345</y>
