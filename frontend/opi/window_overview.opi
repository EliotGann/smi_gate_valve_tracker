  <widget typeId="org.csstudio.opibuilder.widgets.polygon" version="1.0.0">
    <name>incoming_beam</name>
    <x>1300</x>
    <y>377</y>
    <width>325</width>
    <height>66</height>
    <foreground_color>
      <color red="140" green="145" blue="150" />
    </foreground_color>
    <background_color>
      <color red="140" green="145" blue="150" />
    </background_color>
    <line_color>
