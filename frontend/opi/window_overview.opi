      <color red="35" green="45" blue="55" />
    </foreground_color>
    <line_color>
      <color red="35" green="45" blue="55" />
    </line_color>
    <line_width>2</line_width>
    <transparent>false</transparent>
    <rules>
      <rule name="visible" prop_id="visible" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>false</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>false</value>
        </exp>
        <pv trig="true">$(P)View:DetectorValve-Sts</pv>
      </rule>
    </rules>
  </widget>
