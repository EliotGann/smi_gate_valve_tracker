    </line_color>
    <line_width>4</line_width>
    <transparent>false</transparent>
    <points>
      <point x="1625" y="396" />
      <point x="1370" y="396" />
      <point x="1370" y="377" />
      <point x="1300" y="410" />
      <point x="1370" y="443" />
      <point x="1370" y="424" />
      <point x="1625" y="424" />
    </points>
    <rules>
      <rule name="foreground_color" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>
            <color red="210" green="45" blue="45" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>
            <color red="0" green="155" blue="75" />
          </value>
        </exp>
        <pv trig="true">$(P)View:Beam-Sts</pv>
      </rule>
      <rule name="background_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>
            <color red="210" green="45" blue="45" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>
            <color red="0" green="155" blue="75" />
          </value>
        </exp>
        <pv trig="true">$(P)View:Beam-Sts</pv>
      </rule>
      <rule name="line_color" prop_id="line_color" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>
            <color red="210" green="45" blue="45" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>
            <color red="0" green="155" blue="75" />
          </value>
        </exp>
        <pv trig="true">$(P)View:Beam-Sts</pv>
      </rule>
    </rules>
  </widget>
