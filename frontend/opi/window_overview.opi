  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>bow_state</name>
    <x>570</x>
    <y>650</y>
    <width>670</width>
    <height>28</height>
    <text>UNKNOWN / NO DATA</text>
    <rules>
      <rule name="text" prop_id="text" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>No bow shown (balanced or retracted)</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>Pressure pushes LEFT toward intermediate section</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 2">
          <value>Pressure pushes RIGHT toward sample chamber</value>
        </exp>
        <pv trig="true">$(P)View:Bow-Sts</pv>
      </rule>
    </rules>
  </widget>
