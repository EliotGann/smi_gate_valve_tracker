        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>ON: all shutters open</value>
        </exp>
        <pv trig="true">$(P)View:Beam-Sts</pv>
      </rule>
    </rules>
