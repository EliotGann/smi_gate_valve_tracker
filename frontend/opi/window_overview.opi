          <value>true</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>false</value>
        </exp>
        <pv trig="true">$(P)View:Kapton-Sts</pv>
      </rule>
      <rule name="y" prop_id="y" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>230</value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>355</value>
