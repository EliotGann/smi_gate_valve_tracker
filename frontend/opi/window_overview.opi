<?xml version='1.0' encoding='UTF-8'?>
<display typeId="org.csstudio.opibuilder.Display" version="1.0.0">
  <name>SMI KaptonMon | Installed window monitor | beam travels RIGHT to LEFT</name>
  <width>1680</width>
  <height>1100</height>
  <show_grid>false</show_grid>
  <macros>
    <include_parent_macros>true</include_parent_macros>
    <P>XF:12IDC-ES{KaptonMon:1}</P>
  </macros>
  <background_color>
    <color red="245" green="245" blue="245" />
  </background_color>
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>title</name>
    <x>20</x>
    <y>20</y>
    <width>1620</width>
    <height>28</height>
    <text>SMI KaptonMon | Installed window monitor | beam travels RIGHT to LEFT</text>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="1.0.0">
    <name>open_window_details.opi</name>
    <x>1120</x>
    <y>65</y>
    <width>240</width>
    <height>28</height>
    <text>Detailed statistics</text>
    <actions hook="false" hook_all="false">
      <action type="OPEN_DISPLAY">
        <path>window_details.opi</path>
        <mode>0</mode>
        <macros>
          <include_parent_macros>true</include_parent_macros>
        </macros>
      </action>
    </actions>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.ActionButton" version="1.0.0">
    <name>open_commissioning_overview.opi</name>
    <x>1390</x>
    <y>65</y>
    <width>240</width>
    <height>28</height>
    <text>Input diagnostics</text>
    <actions hook="false" hook_all="false">
      <action type="OPEN_DISPLAY">
        <path>commissioning_overview.opi</path>
        <mode>0</mode>
        <macros>
          <include_parent_macros>true</include_parent_macros>
        </macros>
      </action>
    </actions>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.TextUpdate" version="1.0.0">
    <name>heartbeat</name>
    <x>20</x>
    <y>65</y>
    <width>120</width>
    <height>28</height>
    <pv_name>$(P)Heartbeat-I</pv_name>
    <format_type>6</format_type>
    <precision>6</precision>
    <precision_from_pv>false</precision_from_pv>
    <show_units>false</show_units>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.Label" version="1.0.0">
    <name>heartbeat_label</name>
    <x>150</x>
    <y>65</y>
    <width>400</width>
    <height>28</height>
    <text>IOC heartbeat (must advance)</text>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.Rectangle" version="1.0.0">
    <name>sample_chamber</name>
    <x>840</x>
    <y>230</y>
    <width>440</width>
    <height>360</height>
    <background_color>
      <color red="140" green="145" blue="150" />
    </background_color>
    <foreground_color>
      <color red="35" green="45" blue="55" />
    </foreground_color>
    <line_color>
      <color red="35" green="45" blue="55" />
    </line_color>
    <line_width>2</line_width>
    <transparent>false</transparent>
    <rules>
      <rule name="background_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>
            <color red="190" green="222" blue="245" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>
            <color red="245" green="245" blue="245" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 2">
          <value>
            <color red="249" green="220" blue="145" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 3">
          <value>
            <color red="210" green="205" blue="240" />
          </value>
        </exp>
        <pv trig="true">$(P)View:Sample-Sts</pv>
      </rule>
    </rules>
  </widget>
  <widget typeId="org.csstudio.opibuilder.widgets.Rectangle" version="1.0.0">
    <name>intermediate_section</name>
    <x>350</x>
    <y>290</y>
    <width>370</width>
    <height>240</height>
    <background_color>
      <color red="140" green="145" blue="150" />
    </background_color>
    <foreground_color>
      <color red="35" green="45" blue="55" />
    </foreground_color>
    <line_color>
      <color red="35" green="45" blue="55" />
    </line_color>
    <line_width>2</line_width>
    <transparent>false</transparent>
    <rules>
      <rule name="background_color" prop_id="background_color" out_exp="false">
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 0">
          <value>
            <color red="190" green="222" blue="245" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 1">
          <value>
            <color red="245" green="245" blue="245" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 2">
          <value>
            <color red="249" green="220" blue="145" />
          </value>
        </exp>
        <exp bool_exp="pvSev0 &gt;= 0 &amp;&amp; pv0 == 3">
          <value>
            <color red="210" green="205" blue="240" />
          </value>
        </exp>
        <pv trig="true">$(P)View:Intermediate-Sts</pv>
      </rule>
    </rules>
  </widget>
